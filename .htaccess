Options -Indexes
RewriteEngine On
# Bloqueia acesso direto a includes/config
RewriteRule ^(config|includes|sql|apache)/ - [F,L]
# Protege uploads de execução PHP
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^(index|login|logout|dashboard|escolas|tipos_arquivo|configuracoes|usuarios|pastas|pasta_nova|pasta_view|gerar_termo)\.php$">
  Require all granted
</FilesMatch>
# Alternativa simples: se não quiser rewrite, remova bloco acima e mantenha apenas Options
